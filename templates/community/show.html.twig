{% extends 'base.html.twig' %}

{% block title %}{{ community.name }}{% endblock %}

{% block body %}
    <style>
        .community-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 0.5rem;
        }
        .community-table th,
        .community-table td {
            padding: 0.75rem 0.5rem;
            text-align: left;
            border-bottom: 1px solid var(--color-grey5);
        }
        .community-table th {
            font-weight: 600;
            color: var(--color-grey12);
            border-bottom: 2px solid var(--color-grey6);
        }
        .community-table tbody tr:hover {
            background-color: var(--color-grey2);
        }
        [data-color-scheme="dark"] .community-table tbody tr:hover {
            background-color: var(--color-grey3);
        }
    </style>

    <div class="wrapper wrapper--large wrapper--center flow flow--larger">
        {# Header & Meta #}
        <div class="infobox-card flow flow--small">
            <div class="infobox-card__header">
                <div class="infobox-card__title-area">
                    {% if community.localizedNames %}
                        <div
                            data-controller="description-translator"
                            data-description-translator-descriptions-value="{{ community.localizedNames | json_encode }}"
                            style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;"
                        >
                            <h1 data-description-translator-target="content" class="infobox-card__title" style="display: inline-block;">
                                {{ community.nameForLocale(app.request.locale) }}
                            </h1>
                            <span
                                data-description-translator-target="loading"
                                hidden
                                class="text--secondary text--small"
                            >
                                {{ 'polls.show.description.translating' | trans }}
                            </span>
                            <span class="badge badge--neutral" title="{{ 'community.multilingual_available' | trans }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">
                                {{ icon('globe') }} {{ community.localizedNames|length + 1 }}
                            </span>
                        </div>
                    {% else %}
                        <h1 class="infobox-card__title">{{ community.name }}</h1>
                    {% endif %}

                    {% if community.localizedDescriptions %}
                        <div
                            data-controller="description-translator"
                            data-description-translator-descriptions-value="{{ community.localizedDescriptions | json_encode }}"
                        >
                            <p data-description-translator-target="content" class="infobox-card__description">
                                {{ community.descriptionForLocale(app.request.locale)|nl2br }}
                            </p>
                        </div>
                    {% elseif community.description %}
                        <p class="infobox-card__description">
                            {{ community.description|nl2br }}
                        </p>
                    {% endif %}

                    <div class="infobox-card__badges">
                        <span class="badge badge--neutral">
                            {{ icon('user') }} {{ 'community.owner' | trans }}: <strong style="margin-left: 0.2rem;">{{ community.owner.username }}</strong>
                        </span>
                        <span class="badge badge--neutral">
                            {{ icon('users') }} <strong style="margin-right: 0.2rem;">{{ activeMembers|length }}</strong> {{ 'community.members_count' | trans }}
                        </span>
                        {% if community.joinPolicy == 'open' %}
                            <span class="badge badge--success">
                                {{ icon('circle-check') }} {{ 'community.join_policy.open' | trans }}
                            </span>
                        {% else %}
                            <span class="badge badge--neutral">
                                {{ icon('lock') }} {{ 'community.join_policy.approval' | trans }}
                            </span>
                        {% endif %}

                        {% if community.emailEnabled %}
                            <span class="badge badge--primary">
                                {{ icon('bell') }} {{ 'community.emails_active' | trans }}
                            </span>
                        {% else %}
                            <span class="badge badge--neutral" style="color: var(--color-grey10);">
                                {{ icon('bell-slash') }} {{ 'community.emails_disabled' | trans }}
                            </span>
                        {% endif %}

                        {% if community.telegramEnabled %}
                            <span class="badge badge--primary">
                                {{ icon('comment') }} {{ 'community.telegram_active' | trans }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                <div class="infobox-card__actions">
                    {% if isAdmin %}
                        <a href="{{ path('community_settings', { slug: community.slug }) }}" class="button button--secondary">
                            {{ icon('gear') }} {{ 'community.settings.button' | trans }}
                        </a>
                    {% endif %}

                    {% if app.user %}
                        {% if not currentMembership %}
                            <form method="post" action="{{ path('community_join', { slug: community.slug }) }}">
                                <input type="hidden" name="token" value="{{ inviteToken }}">
                                <button type="submit" class="button button--primary">
                                    {{ 'community.join_button' | trans }}
                                </button>
                            </form>
                        {% elseif currentMembership.status == 'pending' %}
                            <span class="badge badge--warning" style="padding: 0.5rem 0.9rem; font-weight: 500; font-size: 0.875rem;">
                                {{ icon('clock') }} {{ 'community.membership.pending' | trans }}
                            </span>
                        {% elseif currentMembership.status == 'active' %}
                            <form method="post" action="{{ path('community_toggle_emails', { slug: community.slug }) }}" style="display: inline;">
                                <button type="submit" class="button button--secondary button--small" title="{{ currentMembership.receiveEmails ? ('community.notifications.mute_hint'|trans) : ('community.notifications.unmute_hint'|trans) }}">
                                    {% if currentMembership.receiveEmails %}
                                        {{ icon('bell') }} {{ 'community.notifications.mute' | trans }}
                                    {% else %}
                                        {{ icon('bell-slash') }} {{ 'community.notifications.unmute' | trans }}
                                    {% endif %}
                                </button>
                            </form>
                            {% if community.owner != app.user %}
                                <form method="post" action="{{ path('community_leave', { slug: community.slug }) }}" onsubmit="return confirm('{{ 'community.leave_confirm' | trans }}');" style="display: inline;">
                                    <button type="submit" class="button button--danger button--small">
                                        {{ 'community.leave_button' | trans }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endif %}
                    {% else %}
                        <a href="{{ path('login') }}" class="button button--secondary">
                            {{ 'community.login_to_join' | trans }}
                        </a>
                    {% endif %}
                </div>
            </div>

            {# Invite Link for Admins / Open policy #}
            {% if isAdmin or (community.joinPolicy == 'open' and currentMembership and currentMembership.status == 'active') %}
                <div class="panel panel--rounded flow flow--tiny" style="margin-top: 1.25rem; padding: 0.85rem 1rem; background: var(--color-grey2); border: 1px solid var(--color-grey6);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                        <div class="text--small" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                            <strong>{{ icon('share') }} {{ 'community.invite_link.label' | trans }}:</strong>
                            <code style="word-break: break-all; padding: 0.25rem 0.5rem; background: var(--color-grey3); border: 1px solid var(--color-grey6); border-radius: var(--border-radius-small, 4px); color: var(--color-primary11); font-size: 0.85rem;">{{ url('community_show', { slug: community.slug, token: community.inviteToken }) }}</code>
                        </div>
                        {% if isAdmin %}
                            <form method="post" action="{{ path('community_regenerate_token', { slug: community.slug }) }}" onsubmit="return confirm('{{ 'community.invite_link.regenerate_confirm' | trans }}');" style="margin: 0;">
                                <button type="submit" class="button button--small button--secondary">
                                    {{ icon('clone') }} {{ 'community.invite_link.regenerate' | trans }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        {# Pending Members Approval Section (for Admins) #}
        {% if isAdmin and pendingMembers|length > 0 %}
            <div class="panel panel--rounded flow flow--small" style="padding: 1.5rem; background: var(--color-grey2); border: 1px solid var(--border-color-warning); border-left: 4px solid var(--border-color-warning);">
                <h2>{{ icon('question') }} {{ 'community.pending_requests.title' | trans }} ({{ pendingMembers|length }})</h2>
                <div style="overflow-x: auto;">
                    <table class="community-table">
                        <thead>
                            <tr>
                                <th>{{ 'community.members.username' | trans }}</th>
                                <th>{{ 'community.members.requested_at' | trans }}</th>
                                <th class="text--right">{{ 'community.members.actions' | trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for member in pendingMembers %}
                                <tr>
                                    <td>
                                        <strong>{{ member.user.username }}</strong>
                                    </td>
                                    <td class="text--secondary text--small">
                                        {{ member.createdAt ? member.createdAt|date('Y-m-d H:i') : '' }}
                                    </td>
                                    <td class="text--right">
                                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                            <form method="post" action="{{ path('community_approve_member', { slug: community.slug, id: member.id }) }}">
                                                <button type="submit" class="button button--small button--primary">
                                                    {{ icon('check') }} {{ 'community.members.approve' | trans }}
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('community_remove_member', { slug: community.slug, id: member.id }) }}">
                                                <button type="submit" class="button button--small button--danger">
                                                    {{ icon('xmark') }} {{ 'community.members.reject' | trans }}
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        {# Community Polls Section #}
        <div class="flow flow--small">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2>{{ icon('chart-simple') }} {{ 'community.polls.title' | trans }}</h2>
                {% if isAdmin or (currentMembership and currentMembership.status == 'active') %}
                    <a href="{{ path('new poll', { community: community.slug }) }}" class="button button--small button--primary">
                        {{ icon('circle-plus') }} {{ 'community.polls.create_button' | trans }}
                    </a>
                {% endif %}
            </div>

            {% if community.polls|length > 0 %}
                <ul class="list--nostyle flow">
                    {% for poll in community.polls %}
                        <li class="panel panel--rounded flow flow--tiny" style="padding: 1.25rem; border: 1px solid var(--color-grey6); background-color: var(--color-grey3);">
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                                <div>
                                    <h3 style="margin: 0;">
                                        <a href="{{ path('poll', { slug: poll.slug ?: poll.id }) }}" style="text-decoration: none;">
                                            {{ poll.title }}
                                        </a>
                                    </h3>
                                    <p class="text--secondary text--small" style="margin: 0.25rem 0 0;">
                                        {% if poll.closed %}
                                            <span class="text--danger">{{ 'polls.summary.is_closed' | trans }}</span>
                                        {% elseif poll.closedAt %}
                                            {% set closeDateTimeStr = poll.closedAt|date('Y-m-d', poll.timezoneName) ~ ' 23:59 (' ~ poll.timezoneName ~ ')' %}
                                            <span class="text--success">
                                                {{ 'polls.public.open_until' | trans({
                                                    date: '<span data-controller="local-time" data-local-time-datetime-value="' ~ (poll.closedAt|date('Y-m-d', poll.timezoneName) ~ 'T23:59:59') ~ '" data-local-time-source-timezone-value="' ~ poll.timezoneName ~ '" data-local-time-format-value="YYYY-MM-DD HH:mm" data-local-time-show-timezone-value="true">' ~ closeDateTimeStr ~ '</span>'
                                                }) | raw }}
                                            </span>
                                        {% endif %}
                                        · {{ 'community.polls.votes_count' | trans({ count: poll.votes|length }) }}
                                        {% if poll.communityOnlyVote %}
                                            · <span class="text--bold">{{ icon('lock') }} {{ 'community.polls.members_only_badge' | trans }}</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div>
                                    <a href="{{ path('poll', { slug: poll.slug ?: poll.id }) }}" class="button button--small">
                                        {{ 'polls.show.poll' | trans }}
                                    </a>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text--secondary">
                    {{ 'community.polls.none' | trans }}
                </p>
            {% endif %}
        </div>

        {# Members List & Add Member Section #}
        <div class="flow flow--small">
            <h2>{{ icon('users') }} {{ 'community.members.title' | trans }} ({{ activeMembers|length }})</h2>

            {% if isAdmin and addMemberForm %}
                <details class="panel panel--rounded" style="padding: 0; background: var(--color-grey2); border: 1px solid var(--color-grey6);">
                    <summary style="padding: 0.85rem 1.25rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: space-between; user-select: none;">
                        <span>{{ icon('circle-plus') }} {{ 'community.members.add_manual.title' | trans }}</span>
                        <span class="button button--small button--secondary" style="pointer-events: none;">+ {{ 'community.members.add_manual.button_toggle' | trans }}</span>
                    </summary>
                    <div class="flow flow--tiny" style="padding: 1rem 1.25rem 1.25rem; border-top: 1px solid var(--color-grey6);">
                        <p class="text--secondary text--small" style="margin: 0;">
                            {{ 'community.members.add_manual.help' | trans }}
                        </p>
                        {{ form_start(addMemberForm, { action: path('community_add_member', { slug: community.slug }) }) }}
                            <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; margin-top: 0.5rem;">
                                <div style="flex: 1; min-width: 200px;">
                                    {{ form_row(addMemberForm.username) }}
                                </div>
                                <div style="min-width: 150px;">
                                    {{ form_row(addMemberForm.role) }}
                                </div>
                                <div>
                                    {{ form_widget(addMemberForm.submit, { attr: { class: 'button button--primary' } }) }}
                                </div>
                            </div>
                        {{ form_end(addMemberForm) }}
                    </div>
                </details>
            {% endif %}

            <div style="overflow-x: auto;">
                <table class="community-table">
                    <thead>
                        <tr>
                            <th>{{ 'community.members.username' | trans }}</th>
                            <th>{{ 'community.members.role' | trans }}</th>
                            <th>{{ 'community.members.notifications' | trans }}</th>
                            <th>{{ 'community.members.joined_at' | trans }}</th>
                            {% if isAdmin %}
                                <th class="text--right">{{ 'community.members.actions' | trans }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for member in activeMembers %}
                            <tr>
                                <td>
                                    <strong>{{ member.user.username }}</strong>
                                    {% if member.user == community.owner %}
                                        <span class="text--secondary text--small">({{ 'community.owner' | trans }})</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if member.role == 'admin' %}
                                        <span class="text--bold">{{ icon('star') }} {{ 'community.members.role_admin' | trans }}</span>
                                    {% else %}
                                        <span>{{ 'community.members.role_member' | trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text--secondary text--small">
                                    {% if member.receiveEmails %}
                                        <span title="{{ 'community.notifications.member_receiving_emails' | trans }}">{{ icon('bell') }} {{ 'community.notifications.active' | trans }}</span>
                                    {% else %}
                                        <span title="{{ 'community.notifications.member_muted' | trans }}" style="opacity: 0.6;">{{ icon('bell-slash') }} {{ 'community.notifications.muted' | trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text--secondary text--small">
                                    {{ member.createdAt ? member.createdAt|date('Y-m-d') : '' }}
                                </td>
                                {% if isAdmin %}
                                    <td class="text--right">
                                        {% if member.user != community.owner %}
                                            <div style="display: flex; gap: 0.4rem; justify-content: flex-end; align-items: center; flex-wrap: wrap;">
                                                {% if member.role == 'member' %}
                                                    <form method="post" action="{{ path('community_change_member_role', { slug: community.slug, id: member.id }) }}" style="display: inline;">
                                                        <input type="hidden" name="role" value="admin">
                                                        <button type="submit" class="button button--small button--secondary" title="{{ 'community.members.promote_hint' | trans }}">
                                                            {{ icon('star') }} {{ 'community.members.promote' | trans }}
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <form method="post" action="{{ path('community_change_member_role', { slug: community.slug, id: member.id }) }}" onsubmit="return confirm('{{ 'community.members.demote_confirm' | trans({ username: member.user.username }) }}');" style="display: inline;">
                                                        <input type="hidden" name="role" value="member">
                                                        <button type="submit" class="button button--small button--secondary" title="{{ 'community.members.demote_hint' | trans }}">
                                                            {{ 'community.members.demote' | trans }}
                                                        </button>
                                                    </form>
                                                {% endif %}

                                                <form method="post" action="{{ path('community_remove_member', { slug: community.slug, id: member.id }) }}" onsubmit="return confirm('{{ 'community.members.remove_confirm' | trans({ username: member.user.username }) }}');" style="display: inline;">
                                                    <button type="submit" class="button button--small button--danger">
                                                        {{ icon('trash') }} {{ 'community.members.remove' | trans }}
                                                    </button>
                                                </form>
                                            </div>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
