{% extends 'base.html.twig' %}

{% block title %}{{ 'community.settings.title' | trans }} - {{ community.name }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--center flow flow--larger" style="max-width: 650px;">
        <div class="flow">
            <p>
                <a href="{{ path('community_show', { slug: community.slug }) }}" class="text--secondary">
                    &larr; {{ 'community.back_to' | trans({ name: community.name }) }}
                </a>
            </p>
            <h1>{{ 'community.settings.title' | trans }}</h1>
        </div>

        <div class="panel panel--rounded" style="padding: 1.5rem;">
            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="flow">
                    {{ form_row(form.name) }}
                    {{ form_row(form.slug) }}
                    {{ form_row(form.description) }}

                    <fieldset class="panel panel--rounded flow flow--small" style="padding: 1rem; margin-top: 1rem;">
                        <legend class="text--bold">{{ 'community.settings.join_policy.title' | trans }}</legend>
                        {{ form_row(form.joinPolicy) }}
                    </fieldset>

                    <fieldset class="panel panel--rounded flow flow--small" style="padding: 1rem; margin-top: 1rem;">
                        <legend class="text--bold">{{ 'community.settings.telegram.title' | trans }}</legend>
                        <p class="text--secondary text--small">
                            {{ 'community.settings.telegram.help_intro' | trans }}
                        </p>
                        {{ form_row(form.telegramEnabled) }}
                        {{ form_row(form.telegramChatId) }}
                    </fieldset>

                    <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
                        {{ form_widget(form.submit, { attr: { class: 'button button--primary' } }) }}
                        <a href="{{ path('community_show', { slug: community.slug }) }}" class="button button--secondary">
                            {{ 'forms.cancel' | trans }}
                        </a>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
