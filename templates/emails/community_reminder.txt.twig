{% set greeting = 'emails.hello' | trans({ name: user.username }, null, locale) %}
{{ greeting != 'emails.hello' ? greeting : ('Hola, ' ~ user.username ~ ':') }}

{% set bodyText = 'community.emails.reminder.body' | trans({ community_name: communityName|default(community.nameForLocale(locale)), poll_name: pollTitle|default(poll.title) }, null, locale) %}
{{ bodyText != 'community.emails.reminder.body' ? bodyText : ('Te recordamos que la consulta “' ~ (pollTitle|default(poll.title)) ~ '” en la comunidad ' ~ (communityName|default(community.nameForLocale(locale))) ~ ' está próxima a cerrar. ¡Aún puedes emitir tu voto!') }}

{{ pollUrl }}

---
{% set optInfo = 'community.emails.opt_out.info' | trans({}, null, locale) %}
{{ optInfo != 'community.emails.opt_out.info' ? optInfo : 'Preferencias de notificación:' }}
{% set optPoll = 'community.emails.opt_out.poll' | trans({}, null, locale) %}
- {{ optPoll != 'community.emails.opt_out.poll' ? optPoll : 'No volver a recibir recordatorios sobre esta encuesta' }}:
  {{ pollOptOutUrl }}
{% set optComm = 'community.emails.opt_out.community' | trans({ community_name: communityName|default(community.nameForLocale(locale)) }, null, locale) %}
- {{ optComm != 'community.emails.opt_out.community' ? optComm : ('Silenciar notificaciones por correo para ' ~ (communityName|default(community.nameForLocale(locale)))) }}:
  {{ communityOptOutUrl }}
