{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'community.notifications.reminder_title' | trans({}, null, locale) | default('Recordatorio de votación') }}: {{ pollTitle|default(poll.title) }}{% endblock %}

{% block content %}
    {% set greeting = 'emails.hello' | trans({ name: user.username }, null, locale) %}
    <p style="margin: 0 0 16px 0; font-size: 16px; color: #54595d;">
        {{ greeting != 'emails.hello' ? greeting : ('Hola, ' ~ user.username ~ ':') }}
    </p>

    {% if reason|default('milestone') == 'leader_change' %}
        {% set leaderTitle = 'community.notifications.leader_changed' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #fef3d6; border: 1px solid #f9bc00; border-radius: 4px; font-size: 13px; font-weight: 700; color: #7c4a00; margin-bottom: 12px;">
            🏆 {{ leaderTitle != 'community.notifications.leader_changed' ? leaderTitle : '¡Cambio en la opción en cabeza!' }}
        </div>
    {% elseif milestone|default(null) == '6h' %}
        {% set rem6h = 'community.notifications.reminder_6h' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #ffebe9; border: 1px solid #d73343; border-radius: 4px; font-size: 13px; font-weight: 700; color: #b32424; margin-bottom: 12px;">
            🔥 {{ rem6h != 'community.notifications.reminder_6h' ? rem6h : '¡Últimas 6 horas para votar!' }}
        </div>
    {% elseif milestone|default(null) == '12h' %}
        {% set rem12h = 'community.notifications.reminder_12h' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #ffebe9; border: 1px solid #d73343; border-radius: 4px; font-size: 13px; font-weight: 700; color: #b32424; margin-bottom: 12px;">
            🚨 {{ rem12h != 'community.notifications.reminder_12h' ? rem12h : '¡Últimas 12 horas para votar!' }}
        </div>
    {% elseif milestone|default(null) == '72h' %}
        {% set rem72h = 'community.notifications.reminder_72h' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #fff9ea; border: 1px solid #fed56d; border-radius: 4px; font-size: 13px; font-weight: 600; color: #725100; margin-bottom: 12px;">
            ⏰ {{ rem72h != 'community.notifications.reminder_72h' ? rem72h : 'Recordatorio: Faltan 72 horas' }}
        </div>
    {% elseif milestone|default(null) == '6d' %}
        {% set rem6d = 'community.notifications.reminder_6d' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #fff9ea; border: 1px solid #fed56d; border-radius: 4px; font-size: 13px; font-weight: 600; color: #725100; margin-bottom: 12px;">
            ⏰ {{ rem6d != 'community.notifications.reminder_6d' ? rem6d : 'Recordatorio: Faltan 6 días' }}
        </div>
    {% else %}
        {% set reminderTitle = 'community.notifications.reminder_title' | trans({}, null, locale) %}
        <div style="display: inline-block; padding: 4px 10px; background-color: #fff9ea; border: 1px solid #fed56d; border-radius: 4px; font-size: 13px; font-weight: 600; color: #725100; margin-bottom: 12px;">
            ⏰ {{ reminderTitle != 'community.notifications.reminder_title' ? reminderTitle : 'Recordatorio de votación' }}
        </div>
    {% endif %}

    <h1 style="margin: 0 0 12px 0; font-size: 22px; font-weight: 700; color: #202122; line-height: 1.3;">
        {{ pollTitle|default(poll.title) }}
    </h1>

    {% if reason|default('milestone') == 'leader_change' and leadingLabel|default(false) %}
        {% set leaderBody = 'community.emails.reminder.leader_body' | trans({ community_name: communityName|default(community.nameForLocale(locale)), poll_name: pollTitle|default(poll.title), leading_option: leadingLabel, votes_count: leadingVotes|default(1) }, null, locale) %}
        <p style="margin: 0 0 20px 0; font-size: 15px; color: #202122;">
            {{ leaderBody != 'community.emails.reminder.leader_body' ? leaderBody : ('¡La opción en cabeza ha cambiado! La propuesta “' ~ leadingLabel ~ '” lidera ahora con ' ~ (leadingVotes|default(1)) ~ ' votos a favor. ¡Tu voto puede marcar la diferencia!') }}
        </p>
    {% else %}
        {% set bodyText = 'community.emails.reminder.body' | trans({ community_name: communityName|default(community.nameForLocale(locale)), poll_name: pollTitle|default(poll.title) }, null, locale) %}
        <p style="margin: 0 0 20px 0; font-size: 15px; color: #202122;">
            {{ bodyText != 'community.emails.reminder.body' ? bodyText : ('Te recordamos que la consulta “' ~ (pollTitle|default(poll.title)) ~ '” en la comunidad ' ~ (communityName|default(community.nameForLocale(locale))) ~ ' está próxima a cerrar. ¡Aún puedes emitir tu voto!') }}
        </p>
    {% endif %}

    {% if poll.closedAt %}
        <div style="margin: 0 0 24px 0; padding: 12px 16px; background-color: #f8f9fa; border-left: 3px solid #ffb800; border-radius: 4px; font-size: 14px; color: #202122;">
            {% set closedLabel = 'polls.summary.closed_at' | trans({}, null, locale) %}
            <strong>📅 {{ closedLabel != 'polls.summary.closed_at' ? closedLabel : 'Fecha de cierre' }}:</strong>
            {{ poll.closedAt | date('Y-m-d') }}{% if poll.timezoneName and poll.timezoneName != 'UTC' %} ({{ poll.timezoneName }}){% endif %}
        </div>
    {% endif %}

    <!-- Codex Primary Button CTA -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 24px 0 20px 0;">
        <tr>
            <td align="center" bgcolor="#3366cc" style="border-radius: 6px;">
                {% set voteBtn = 'community.notifications.vote_now' | trans({}, null, locale) %}
                <a href="{{ pollUrl }}" target="_blank" style="display: inline-block; padding: 12px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 6px; letter-spacing: 0.2px;">
                    🗳️ {{ voteBtn != 'community.notifications.vote_now' ? voteBtn : 'Emitir mi voto' }} &rarr;
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
