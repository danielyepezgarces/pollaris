{% extends 'emails/layout.html.twig' %}

{% block title %}{{ pollTitle|default(poll.title) }} - {{ communityName|default(community.nameForLocale(locale)) }}{% endblock %}

{% block content %}
    {% set greeting = 'emails.hello' | trans({ name: user.username }, null, locale) %}
    <p style="margin: 0 0 16px 0; font-size: 16px; color: #54595d;">
        {{ greeting != 'emails.hello' ? greeting : ('Hola, ' ~ user.username ~ ':') }}
    </p>

    <h1 style="margin: 0 0 12px 0; font-size: 22px; font-weight: 700; color: #202122; line-height: 1.3;">
        {{ pollTitle|default(poll.title) }}
    </h1>

    {% set bodyText = 'community.emails.new_poll.body' | trans({ community_name: communityName|default(community.nameForLocale(locale)), poll_name: pollTitle|default(poll.title) }, null, locale) %}
    <p style="margin: 0 0 20px 0; font-size: 15px; color: #202122;">
        {{ bodyText != 'community.emails.new_poll.body' ? bodyText : ('Se ha publicado una nueva consulta “' ~ (pollTitle|default(poll.title)) ~ '” en la comunidad ' ~ (communityName|default(community.nameForLocale(locale))) ~ '. Puedes emitir tu voto en el siguiente enlace:') }}
    </p>

    {% if poll.description %}
        <div style="margin: 0 0 24px 0; padding: 14px 18px; background-color: #f8f9fa; border-left: 3px solid #3366cc; border-radius: 4px; font-size: 14px; color: #54595d; line-height: 1.5;">
            {{ poll.description | length > 280 ? (poll.description | slice(0, 280) ~ '...') : poll.description }}
        </div>
    {% endif %}

    <!-- Codex Primary Button CTA -->
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 24px 0 20px 0;">
        <tr>
            <td align="center" bgcolor="#3366cc" style="border-radius: 6px;">
                <a href="{{ pollUrl }}" target="_blank" style="display: inline-block; padding: 12px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 6px; letter-spacing: 0.2px;">
                    🗳️ {{ 'polls.show.vote_action' | trans({}, null, locale) | default('Emitir mi voto') }} &rarr;
                </a>
            </td>
        </tr>
    </table>

    <p style="margin: 0; font-size: 13px; color: #72777d;">
        <span style="word-break: break-all;">{{ pollUrl }}</span>
    </p>
{% endblock %}
