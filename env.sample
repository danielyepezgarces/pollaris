# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE.
# Use ".env.local" for local overrides during development.
# Use real environment variables when deploying to production.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=2138adfc583ae0317e1cb5bf9b6574f8
###< symfony/framework-bundle ###

###> app ###
# A secret used to generate security tokens, **it must be changed!**
# Generate a token with the command: openssl rand -hex 64

# The base URL that serves your application. It is used to generate URLs in
# non-HTTP contexts (i.e. from the command line).
# APP_BASE_URL="https://example.org"

# Set to customise the name of the application ("Pollaris" by default).
# APP_NAME="Pollaris"

# Uncomment to force the polls' authors to enter an email.
# APP_REQUIRE_EMAILS=true

# Define the default timezone (uses the INI date.timezone value by default)
# APP_TIMEZONE="Europe/Paris"

# Wikimedia OAuth 1.0a login. Register your app on Wikimedia and fill these
# values to allow login with Wikipedia / Wikimedia accounts.
# The registered Wikimedia callback URL must use the same public host as
# APP_BASE_URL, e.g. https://pollaris.toolforge.org/login/wikimedia/callback.
# WIKIMEDIA_OAUTH_ENABLED=true
# WIKIMEDIA_OAUTH_BASE_URL="https://meta.wikimedia.org/w/rest.php/oauth"
# WIKIMEDIA_OAUTH_CLIENT_ID=""
# WIKIMEDIA_OAUTH_CLIENT_SECRET=""
# WIKIMEDIA_OAUTH_USER_AGENT="Pollaris/1.1.3 (https://pollaris.example.org; admin@example.org)"

####################################
# Poll expiration configuration    #
####################################

# Number of days before deleting completed polls (results visible)
# POLL_EXPIRES_COMPLETED=180

# Number of days before deleting incomplete polls (results not visible)
# POLL_EXPIRES_INCOMPLETE=90

# Format used by PHP DateTimeImmutable (default: "-30 days")
# POLL_EXPIRES_VOTES="-30 days"

###> symfony/mailer ###
# MAILER_DSN=null://null
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# Format: mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
